{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "base_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      },
      "minItems": 1,
      "maxItems": 512
    },
    "focus": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "facts",
          "beliefs",
          "relations",
          "state",
          "summaries",
          "foreshadow",
          "highlights",
          "theme"
        ]
      },
      "minItems": 1,
      "maxItems": 512,
      "uniqueItems": true
    },
    "instructions": {
      "type": "string",
      "maxLength": 8000
    },
    "summary_target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "unit_id",
        "title",
        "timeline"
      ],
      "properties": {
        "level": {
          "enum": [
            "scene",
            "chapter",
            "volume",
            "book"
          ]
        },
        "unit_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "timeline": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "item_id": {
          "pattern": "^[a-f0-9]{32}$",
          "type": "string"
        },
        "revision": {
          "pattern": "^[a-f0-9]{32}$",
          "type": "string"
        }
      }
    }
  },
  "required": [
    "schema",
    "project_id",
    "base_revision",
    "scope",
    "sources",
    "focus",
    "instructions"
  ],
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "branch_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "story_time": {
          "type": "integer",
          "minimum": 0
        },
        "known_from": {
          "type": "integer",
          "minimum": 0
        },
        "perspective_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "visibility": {
          "type": "string",
          "enum": [
            "public",
            "restricted",
            "private"
          ]
        },
        "known_by": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "minItems": 0,
          "maxItems": 512,
          "uniqueItems": true
        }
      },
      "required": [
        "branch_id",
        "story_time",
        "known_from",
        "perspective_id",
        "visibility",
        "known_by"
      ]
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resource_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "start_rune": {
          "type": "integer",
          "minimum": 0
        },
        "end_rune": {
          "type": "integer",
          "minimum": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        }
      },
      "required": [
        "resource_id",
        "revision",
        "hash",
        "start_rune",
        "end_rune",
        "quote"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resource_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "chapter",
            "planning",
            "memory",
            "adaptation"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200000
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "control": {
          "type": "boolean"
        },
        "until": {
          "type": "integer",
          "maximum": 9007199254740991,
          "minimum": 0
        }
      },
      "required": [
        "resource_id",
        "revision",
        "hash",
        "kind",
        "text",
        "scope"
      ]
    }
  }
}