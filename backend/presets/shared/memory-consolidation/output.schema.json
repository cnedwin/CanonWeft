{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": 1
    },
    "status": {
      "const": "CANDIDATE"
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "base_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "kind": {
            "type": "string",
            "enum": [
              "fact",
              "belief",
              "claim",
              "relation",
              "state",
              "summary",
              "foreshadow",
              "highlight",
              "theme_check"
            ]
          },
          "layer": {
            "type": "string",
            "enum": [
              "working",
              "episodic",
              "semantic",
              "narrative",
              "canon"
            ]
          },
          "subject_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              {
                "type": "null"
              }
            ]
          },
          "holder_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              {
                "type": "null"
              }
            ]
          },
          "object_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              {
                "type": "null"
              }
            ]
          },
          "predicate": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "context": {
            "type": "string",
            "enum": [
              "reality",
              "dream",
              "flashback",
              "hypothetical",
              "plan"
            ]
          },
          "summary_level": {
            "type": "string",
            "enum": [
              "none",
              "scene",
              "chapter",
              "volume",
              "book"
            ]
          },
          "narrative_role": {
            "type": "string",
            "enum": [
              "none",
              "setup",
              "payoff",
              "unresolved"
            ]
          },
          "scope": {
            "$ref": "#/$defs/scope"
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/anchor"
            },
            "minItems": 1,
            "maxItems": 64
          },
          "disposition": {
            "type": "string",
            "enum": [
              "proposed",
              "conflict",
              "needs_confirmation"
            ]
          },
          "related_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "minItems": 0,
            "maxItems": 512,
            "uniqueItems": true
          },
          "check_result": {
            "type": "string",
            "enum": [
              "not_applicable",
              "aligned",
              "deviation",
              "unknown"
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "layer",
          "subject_id",
          "holder_id",
          "object_id",
          "predicate",
          "statement",
          "context",
          "summary_level",
          "narrative_role",
          "scope",
          "evidence",
          "disposition",
          "related_ids",
          "check_result"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "enum": [
                    "belief",
                    "claim"
                  ]
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "holder_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "relation"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "subject_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "object_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "summary"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "summary_level": {
                  "type": "string",
                  "enum": [
                    "scene",
                    "chapter",
                    "volume",
                    "book"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "theme_check"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "check_result": {
                  "type": "string",
                  "enum": [
                    "aligned",
                    "deviation",
                    "unknown"
                  ]
                }
              }
            }
          }
        ]
      },
      "minItems": 0,
      "maxItems": 512
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "kind": {
            "type": "string",
            "enum": [
              "conflict",
              "missing_source",
              "ambiguous_time",
              "visibility",
              "theme_drift",
              "pending_confirmation"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "candidate_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "minItems": 0,
            "maxItems": 512,
            "uniqueItems": true
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/anchor"
            },
            "minItems": 1,
            "maxItems": 64
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          }
        },
        "required": [
          "id",
          "kind",
          "description",
          "candidate_ids",
          "evidence",
          "question"
        ]
      },
      "minItems": 0,
      "maxItems": 512
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 8000
      },
      "minItems": 0,
      "maxItems": 512
    }
  },
  "required": [
    "schema",
    "status",
    "project_id",
    "base_revision",
    "scope",
    "candidates",
    "findings",
    "limitations"
  ],
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "branch_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "story_time": {
          "type": "integer",
          "minimum": 0
        },
        "known_from": {
          "type": "integer",
          "minimum": 0
        },
        "perspective_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "visibility": {
          "type": "string",
          "enum": [
            "public",
            "restricted",
            "private"
          ]
        },
        "known_by": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "minItems": 0,
          "maxItems": 512,
          "uniqueItems": true
        }
      },
      "required": [
        "branch_id",
        "story_time",
        "known_from",
        "perspective_id",
        "visibility",
        "known_by"
      ]
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resource_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "start_rune": {
          "type": "integer",
          "minimum": 0
        },
        "end_rune": {
          "type": "integer",
          "minimum": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        }
      },
      "required": [
        "resource_id",
        "revision",
        "hash",
        "start_rune",
        "end_rune",
        "quote"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resource_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "chapter",
            "planning",
            "memory",
            "adaptation"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200000
        },
        "scope": {
          "$ref": "#/$defs/scope"
        }
      },
      "required": [
        "resource_id",
        "revision",
        "hash",
        "kind",
        "text",
        "scope"
      ]
    }
  }
}
